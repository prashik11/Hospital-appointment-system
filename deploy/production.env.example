# Copy to /etc/shree-pharma-clinic.env on the VPS; never commit the real file.
NODE_ENV=production
HOST=127.0.0.1
PORT=5000
MONGO_URI=mongodb+srv://PROD_DB_USER:URL_ENCODED_PASSWORD@YOUR_PROD_CLUSTER.mongodb.net/shree_pharma_clinic_prod?retryWrites=true&w=majority
CLIENT_ORIGIN=https://YOUR_DOMAIN.in
HOSPITAL_TIME_ZONE=Asia/Kolkata
TRUST_PROXY=1
COOKIE_SAME_SITE=lax
